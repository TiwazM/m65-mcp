10 REM M65-MCP SDK: FROM BASIC 65, WITH POKE AND PEEK
20 M=$FFDF000
30 IF PEEK(M+$101)<>$4D THEN PRINT "NO M65-MCP IN THIS CORE":END
40 PRINT CHR$(147)"M65-MCP SDK: BASIC"
50 POKE M+$107,0:REM MRESET
60 POKE M+$180+$15,$02:REM FCONST F0, 2.0
70 POKE M+$180+$0A,$00:REM FSQRT  F0, F0
80 POKE M+$180+$11,$00:REM FTOX   F0: MINT = F0 X 65536
90 IF PEEK(M+$100) AND 1 THEN 90:REM WAIT FOR THE UNIT
100 X=PEEK(M+$108)+256*PEEK(M+$109)+65536*PEEK(M+$10A)
110 PRINT "SQRT(2) =";X/65536
120 POKE M+$180+$15,$15:REM FCONST F1, PI
130 POKE M+$180+$04,$10:REM FMUL   F1, F0
140 POKE M+$180+$11,$01:REM FTOX   F1
150 IF PEEK(M+$100) AND 1 THEN 150
160 X=PEEK(M+$108)+256*PEEK(M+$109)+65536*PEEK(M+$10A)
170 PRINT "PI SQRT(2) =";X/65536
